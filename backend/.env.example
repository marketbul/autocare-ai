# --- Database -------------------------------------------------------------
# Dev:  sqlite:///autocare.db
# Prod: postgresql://autocare:autocare@localhost:5432/autocare   (needs pgvector)
AUTOCARE_DATABASE_URL=sqlite:///autocare.db

# --- Models -----------------------------------------------------------------
# models = BAAI/bge-m3 + BAAI/bge-reranker-v2-m3 (multilingual; ~2.5 GB download first run)
# lite   = lexical stand-ins, no downloads (dev only, cannot understand Urdu)
AUTOCARE_ML_BACKEND=models
AUTOCARE_EMBEDDING_MODEL=BAAI/bge-m3
AUTOCARE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Answer generation --------------------------------------------------------
# llm        = any OpenAI-compatible /chat/completions endpoint
# extractive = quote passages verbatim, English only (no key needed)
AUTOCARE_GENERATION_MODE=llm
# Groq (free tier):   https://api.groq.com/openai/v1   model e.g. openai/gpt-oss-120b
# OpenAI:             https://api.openai.com/v1        model e.g. gpt-4o-mini
# Ollama (local):     http://localhost:11434/v1         model e.g. qwen2.5:7b   (key can be blank)
AUTOCARE_LLM_BASE_URL=https://api.groq.com/openai/v1
AUTOCARE_LLM_API_KEY=
AUTOCARE_LLM_MODEL=openai/gpt-oss-120b

# --- Retrieval & gates (UNTUNED defaults: set from the risk-coverage curve) -----
AUTOCARE_CANDIDATE_K=20
AUTOCARE_FINAL_K=5
AUTOCARE_HYBRID_ALPHA=0.5
AUTOCARE_MIN_EVIDENCE_SCORE=0.30
AUTOCARE_MIN_CLAIM_SUPPORT=0.25

AUTOCARE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Story 4: urgency classifier ----------------------------------------------
# Trained automatically on first start (or: python -m ingest.train_triage).
AUTOCARE_TRIAGE_MODEL=models/triage.pkl
# Blank = data/symptom_labels.csv if it exists, else the starter set.
AUTOCARE_TRIAGE_DATA=

# --- Story 3: fault code from a scanner photo ---------------------------------
# vision    = vision model on the LLM endpoint above (photo read twice, reads must agree)
# tesseract = local OCR; install Tesseract, set AUTOCARE_TESSERACT_CMD if not on PATH
# off       = disabled (owners type the code)
AUTOCARE_CODE_READER=vision
AUTOCARE_VISION_MODEL=qwen/qwen3.8-27b
# Story 12: damage photos. vision = interim assessor on the same vision model; off = disabled
AUTOCARE_DAMAGE_ASSESSOR=vision
