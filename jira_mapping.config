# Jira CSV Importer Configuration File for AutoCare AI
# This file automatically maps all CSV fields into Jira Software

config.version = 2.0
config.project.from.csv = false
config.project.key = AUT
config.project.name = AUTOCARE AI
config.date.format = yyyy-MM-dd
config.email.suffix = @gmail.com

# Field Mappings
field.Summary = summary
field.Issue\ key = issuekey
field.Issue\ Type = issuetype
field.Description = description
field.Assignee = assignee
field.Reporter = reporter
field.Priority = priority
field.Status = status
field.Story\ Points = customfield_10016
field.Epic\ Link = customfield_10014
field.Sprint = customfield_10020
field.Resolved\ Date = resolutiondate
field.Commit\ Hash = environment
field.Git\ Commit\ Message = comment

# Value Mappings
value.issuetype.Story = 10001
value.issuetype.Task = 10002
value.issuetype.Bug = 10004
value.status.Done = 10002
value.status.To\ Do = 10000
value.status.In\ Progress = 10001
