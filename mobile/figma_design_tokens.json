      "description": "Faint inner highlight with ambient depth"
    },
    "glow-violet": {
      "value": "0 8px 32px rgba(139, 92, 246, 0.25), inset 0 1px 0 rgba(255,255,255,0.1)",
      "type": "boxShadow"
    },
    "frosted-nav": {
      "value": "0 10px 40px rgba(0,0,0,0.65), 0 0 0 1px rgba(255,255,255,0.08)",
      "type": "boxShadow"
    }
  },
